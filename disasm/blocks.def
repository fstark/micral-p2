; MICRAL P2 Boot ROM block definitions
reset_init: start 0x0000 last 0x0032 type code
pad_rst30: start 0x0033 last 0x0037 type bytedata
irq_handler: start 0x0038 last 0x003c type code
pad_vectors: start 0x003d last 0x0065 type bytedata
nmi_handler: start 0x0066 last 0x006d type code
init_display: start 0x006e last 0x0092 type code
monitor: start 0x0093 last 0x00f5 type code
boot_loader: start 0x00f6 last 0x01bc type code
fdc_io: start 0x01bd last 0x02f0 type code
hex_parser: start 0x02f1 last 0x0317 type code
cmd_star_cr_go: start 0x0318 last 0x034e type code
cmd_memory: start 0x034f last 0x042b type code
hex_output: start 0x042c last 0x0476 type code
kbd_driver: start 0x0477 last 0x04c8 type code
char_io_video: start 0x04c9 last 0x05f9 type code
post_code: start 0x05fa last 0x0789 type code
str_prompt: start 0x078a last 0x0797 type bytedata
str_autotest: start 0x0798 last 0x07a7 type bytedata
floppy_data: start 0x07a8 last 0x07ff type bytedata
